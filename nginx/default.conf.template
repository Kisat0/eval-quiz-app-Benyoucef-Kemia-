# Template nginx : ${BACKEND_URL} est remplacé au démarrage du conteneur
# par le script 20-envsubst-on-templates.sh de l'image nginx.
#   - Docker Compose        : BACKEND_URL=http://backend:3007
#   - Azure Container Apps  : BACKEND_URL=http://<nom-app-backend> (ingress interne, port 80)

server {
    listen 8080;
    server_name localhost;

    root /usr/share/nginx/html;

    # Main app
    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Admin page - serve gestion-quiz.html for /gestion-quiz route
    location = /gestion-quiz {
        try_files /gestion-quiz.html =404;
    }

    # API proxy to backend
    # Pas de "proxy_set_header Host $host" : l'en-tête Host reste celui du backend.
    # Sur Container Apps, le proxy Envoy route les requêtes selon Host ;
    # transmettre l'hôte du frontend enverrait la requête au mauvais service.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Health check endpoint
    location /health {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
    }
}
