# Modèle des variables lues par scripts/deploy.sh.
# Copier en .env.azure à la racine du dépôt (fichier ignoré par Git) :
#   cp scripts/env.azure.example .env.azure
# Ne JAMAIS commiter .env.azure.

# --- Secrets (obligatoires) ---
JWT_SECRET=a-generer-avec-openssl-rand-hex-32
ADMIN_PASSWORD=a-choisir
# Clé factice acceptée : le backend démarre, l'envoi d'email échoue proprement
RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Base de données (optionnelle au J4, requise au J5) ---
# Exemple Neon : postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# --- Paramètres (optionnels, valeurs par défaut dans deploy.sh) ---
# ADMIN_USERNAME=admin
# FROM_EMAIL=Quiz App <noreply@votredomaine.com>
# LOCATION=francecentral
# RG=rg-quiz-app
# ACR_NAME=acrquizbenyoucefkemia
# MIN_REPLICAS=0
